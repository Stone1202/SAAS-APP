# ============================================
# .gitignore — 多人多项目工作空间
# ============================================

# Dependencies
node_modules/
**/node_modules/

# Deploy artifacts（聚合部署产物，运行时生成）
deploy/artifacts/

# Build output — projects/*/dist 需要提交（EdgeOne 端依赖）
# 仅排除 scripts 下的临时 dist
build/
**/build/
scripts/dist/

# CodeBuddy runtime（不提交运行时状态和报告）
.codebuddy/reports/
.codebuddy/_backup/
.codebuddy/_archive/
**/.codebuddy/state.json
**/.codebuddy/journal/

# 知识库待审核区（成员本地，不提交）
.codebuddy/knowledge/domains/_pending/
.codebuddy/knowledge/common/经验库/_pending/

# Environment
*.local
.env.local
.env.*.local

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.swo
*.swn

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Test coverage
coverage/
**/coverage/

# Temporary
*.tmp
*.bak
*.cache

# Playwright
test-results/
playwright-report/
.codebuddy/knowledge/projects/SAAS/学习报告/SAAS-缺失模块学习报告-V1.0.0-20260722.md
.codebuddy/knowledge/projects/SAAS/学习报告/SAAS-项目全貌学习报告-V1.0.0-20260722.md
.codebuddy/knowledge/projects/SAAS/学习报告/SAAS-运营后台深度学习报告-V1.0.0-20260722.md
.codebuddy/knowledge/projects/SAAS/学习报告/SAAS-运营后台学习报告-V1.0.0-20260722.md
.codebuddy/knowledge/projects/SAAS/学习报告/APK反编译学习报告-v1.0.0.md
.playwright-cli/
